# Supabase (optional — without these the app runs on built-in sample data + local storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API for the AI Sourcing Assistant (optional — falls back to a rule-based planner)
ANTHROPIC_API_KEY=

# Deal detector
CRON_SECRET=
DEAL_WEBHOOK_URL=
# Your home location for local-arbitrage distance filtering
HOME_LAT=
HOME_LNG=

# Comma-separated emails allowed to sign in (this is a single-owner app)
ALLOWED_EMAILS=
# Bearer token for POST /api/ingest (market data feed)
INGEST_SECRET=
# Supabase auth user id that receives deal alerts written by the cron job
ALERT_USER_ID=
